{
	"name": "@harnessy/core",
	"version": "0.0.3",
	"description": "Effect-powered Harnessy capability harness CLI and core runtime",
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"bin": {
		"harnessy": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"fixtures",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@effect/platform-node": "4.0.0-beta.85",
		"effect": "4.0.0-beta.85"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.0-beta.85",
		"shx": "0.4.0",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"agent",
		"capabilities",
		"cli",
		"effect",
		"harnessy"
	]
}
