{
  "name": "@executor-js/cloudflare",
  "version": "0.0.32",
  "private": true,
  "type": "module",
  "exports": {
    "./blob-store": {
      "types": "./src/blob-store.ts",
      "default": "./src/blob-store.ts"
    },
    "./mcp/do-headers": {
      "types": "./src/mcp/do-headers.ts",
      "default": "./src/mcp/do-headers.ts"
    },
    "./mcp/agent-durable-object": {
      "types": "./src/mcp/agent-session-durable-object.ts",
      "default": "./src/mcp/agent-session-durable-object.ts"
    },
    "./mcp/execution-owner-directory": {
      "types": "./src/mcp/execution-owner-directory.ts",
      "default": "./src/mcp/execution-owner-directory.ts"
    },
    "./mcp/session-stub": {
      "types": "./src/mcp/session-stub.ts",
      "default": "./src/mcp/session-stub.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@executor-js/api": "workspace:*",
    "@executor-js/execution": "workspace:*",
    "@executor-js/host-mcp": "workspace:*",
    "@executor-js/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.17.3",
    "effect": "4.0.0-beta.85"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@effect/vitest": "4.0.0-beta.85",
    "@types/node": "^24.3.1",
    "bun-types": "^1.2.22",
    "typescript": "^5.9.3",
    "urlpattern-polyfill": "^10.1.0",
    "vitest": "^4.1.5"
  }
}
