{
  "name": "@executor-js/runtime-quickjs",
  "version": "1.5.33",
  "homepage": "https://github.com/UsefulSoftwareCo/executor/tree/main/packages/kernel/runtime-quickjs",
  "bugs": {
    "url": "https://github.com/UsefulSoftwareCo/executor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UsefulSoftwareCo/executor.git",
    "directory": "packages/kernel/runtime-quickjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup && (tsc --declaration --emitDeclarationOnly --outDir dist --rootDir src || true)",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:slow": "bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@executor-js/codemode-core": "workspace:*",
    "quickjs-emscripten": "^0.31.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.85",
    "@types/node": "^24.3.1",
    "bun-types": "^1.2.22",
    "effect": "4.0.0-beta.85",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.85"
  }
}
